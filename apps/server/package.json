{
  "name": "@updown/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc --noEmit -p .",
    "start": "tsx --env-file-if-exists=.env.local src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "backup": "tsx --env-file-if-exists=.env.local src/backup/cli.ts",
    "replays": "tsx --env-file-if-exists=.env.local src/replay/build.ts",
    "predict:approvals": "tsx --env-file-if-exists=.env.local src/predict/approvals.ts"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "@predictdotfun/sdk": "^1.3.8",
    "@updown/protocol": "*",
    "ethers": "^6.17.0",
    "viem": "^2.58.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0"
  }
}
