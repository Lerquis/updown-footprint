PORT=4000
# Origen permitido para el frontend (Origin check de WS). Vacio = permitir todos (solo dev)
ALLOWED_ORIGIN=http://localhost:3000
SYMBOL=btcusdt
# Fuente spot
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
RETENTION_MS=900000
TRADES_MAX=100000
BACKFILL=true
BINANCE_REST_URL=https://api.binance.com/api/v3
# Fuente futures en paralelo (ADR 0016): mismo sistema con el perpetuo USDT-M; base y backups propios
FUTURES_ENABLED=true
# Binance separo las rutas de futuros: aggTrade por /market, libro por /public (en /ws el aggTrade conecta pero no llega nada)
BINANCE_FUTURES_TRADES_WS_URL=wss://fstream.binance.com/market/ws
BINANCE_FUTURES_DEPTH_WS_URL=wss://fstream.binance.com/public/ws
BINANCE_FUTURES_REST_URL=https://fapi.binance.com/fapi/v1
FUTURES_DEPTH_SNAPSHOT_LIMIT=1000
FUTURES_BACKFILL_DELAY_MS=600
# FUTURES_DB_PATH=data/polymarket-futures.db
# ETH como segundo activo (ADR 0018): clon completo de BTC (spot + futures si FUTURES_ENABLED), con bases y backups propios
ETH_ENABLED=true
# ETH_SYMBOL=ethusdt
# ETH_PM_SYMBOL=ETH
# ETH_PM_SLUG_PREFIX=eth-updown-5m
# ETH_CHAINLINK_TWAP_SYMBOL=ethusd
# ETH_CHAINLINK_SYMBOL=eth/usd
# ETH_DEPTH_STEP=0.05
# ETH_FOOTPRINT_TICK=0.05
# ETH_IMBALANCE_MIN_VOL=1.5
# SS (movimientos con fuerza del motor C, con BTC de referencia; solo se muestra)
# ETH_STRENGTH=true
# ETH_DB_PATH=data/polymarket-eth.db
# ETH_FUTURES_DB_PATH=data/polymarket-eth-futures.db
# Heatmap de liquidez (/ws/depth)
DEPTH_STEP=1
DEPTH_RANGE_PCT=0.001
DEPTH_INTERVAL_MS=1000
DEPTH_SNAPSHOT_LIMIT=5000
# Orderflow (footprint, CVD, senales)
BAR_MS=60000
BAR_HISTORY=60
FOOTPRINT_TICK=1
IMBALANCE_RATIO=3
IMBALANCE_MIN_VOL=0.05
IMBALANCE_MIN_STACK=3
# Monitor de escenarios
ANALYSIS_LOOKBACK_MS=300000
ANALYSIS_RECENT_BARS=3
# Polymarket (BTC Up/Down 5m)
PM_HISTORY=24
# Credenciales de Polymarket para el canal TWAP: ponerlas en .env.local (gitignored), NUNCA aqui
# PM_CLOB_API_KEY=
# PM_CLOB_SECRET=
# PM_CLOB_PASSPHRASE=
# PM_CHAINLINK_API_KEY=
# EOA que creo la API key (POLY_ADDRESS de las peticiones autenticadas). Tambien en .env.local
# PM_SIGNER_ADDRESS=
# Proxy wallet de la cuenta (maker de la orden de prueba de latencia). Tambien en .env.local
# PM_FUNDER_ADDRESS=
# Latencia hacia el CLOB (/ws/latency, solo lectura): ver docs/features/latency.md
PM_CLOB_URL=https://clob.polymarket.com
PM_LATENCY_INTERVAL_MS=15000
PM_LATENCY_KEEPALIVE_MS=5000
PM_LATENCY_HISTORY=40
# Compras reales del motor C (docs/features/live-trading.md). Clave y contrasena SOLO en .env.local / Railway
# PM_WALLET_PRIVATE_KEY=
# TRADING_PASSWORD=
PM_LIVE_SCALE=0.2
PM_LIVE_MIN_USD=1
PM_LIVE_MAX_USD=10
PM_LIVE_MAX_MARKET_USD=40
# 1 = sin limite de precio (compra hasta 0.99, vende desde 0.01); 0.02 = senal +-2c
PM_LIVE_SLIPPAGE=1
# Canal de usuario de Polymarket: hora exacta de cada ejecucion
PM_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
# Motor de senales (PM_*)
# Parametros del motor y base de datos: ver docs/features/signal-engine.md
# Se usa con la generacion: data/polymarket-v2.db (ADR 0011)
PM_DB_PATH=data/polymarket.db
# Backups de la base a S3/R2 (docs/guides/deployment.md). Vacio = desactivado. Secretos solo en .env.local / variables de Railway
# BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_PREFIX=updown/
# BACKUP_INTERVAL_H=1
# BACKUP_KEEP_H=48
# BACKUP_SHUTDOWN_TIMEOUT_S=150
# PM_DB_RESTORE=false
PM_FEE_RATE=0.05
PM_MIN_EDGE=0.04
PM_BANKROLL=1000
PM_MODEL_WEIGHT=0.6
PM_FLOW_GAIN=0.3
# Replays del motor A con retraso (npm run replays): copias descargadas de R2 e informe
REPLAY_DIR=data/replays
# Motores A y C: retraso (ms) tras cada segundo de Binance (ver docs/features/engines.md)
PM_ENGINE_A_DELAY_MS=0
PM_ENGINE_C_DELAY_MS=150
# Check maker: ordenes maker REALES (post-only a mejor bid + 1 tick) siguiendo a un motor; se activa en la web con la contrasena de trading
PM_MAKER_CHECK_MAX=30
PM_MAKER_CHECK_REST_MS=2000
PM_MAKER_CHECK_USD=1
# Papel realista de D y E: retraso de una orden taker, de la entrada al libro de una maker y de una cancelacion


# Predict.fun (rondas BTC Up/Down 5m, docs/features/predict-markets.md). La API key SOLO en .env.local / Railway
PREDICT_ENABLED=true
# PREDICT_API_KEY=
PREDICT_REST_URL=https://api.predict.fun
PREDICT_WS_URL=wss://ws.predict.fun/ws
PREDICT_SERIES=btc-updown-5m
# feed Chainlink del WS de Predict: 1 = BTC, 2 = ETH, 3 = BNB
PREDICT_PRICE_FEED_ID=1
# Motores sobre Predict (papel): comision rate*min(p,1-p) y basis contra el Chainlink puntual
PREDICT_ENGINES=true
PREDICT_FEE_RATE=0.02
PREDICT_BASIS_SECONDS=5
# Compras reales en Predict (docs/features/predict-markets.md#compras-reales). Clave SOLO en .env.local / Railway.
# EOA: solo PREDICT_PRIVATE_KEY. Cuenta de Predict (web): PREDICT_ACCOUNT (predict.fun/portfolio) + clave de la wallet de Privy.
# PREDICT_PRIVATE_KEY=
# PREDICT_ACCOUNT=
PREDICT_LIVE_SCALE=0.2
# minimo por compra en USDT (nunca menos de 1, el minimo de Predict)
PREDICT_LIVE_MIN_USD=1
PREDICT_LIVE_MAX_USD=10
PREDICT_LIVE_MAX_MARKET_USD=40
PREDICT_LIVE_SLIPPAGE_BPS=500
PREDICT_LATENCY_INTERVAL_MS=15000
