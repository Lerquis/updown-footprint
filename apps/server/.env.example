PORT=4000
# Origen permitido para el frontend (Origin check de WS). Vacio = permitir todos (solo dev)
ALLOWED_ORIGIN=http://localhost:3000
SYMBOL=btcusdt
# Spot: wss://stream.binance.com:9443/ws  |  Futuros USDT-M: wss://fstream.binance.com/ws
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
RETENTION_MS=900000
TRADES_MAX=100000
BACKFILL=true
BINANCE_REST_URL=https://api.binance.com/api/v3
# Heatmap de liquidez (/ws/depth)
DEPTH_STEP=1
DEPTH_RANGE_PCT=0.001
DEPTH_INTERVAL_MS=1000
DEPTH_SNAPSHOT_LIMIT=5000
# Orderflow (footprint, CVD, senales)
BAR_MS=60000
BAR_HISTORY=60
FOOTPRINT_TICK=1
IMBALANCE_RATIO=3
IMBALANCE_MIN_VOL=0.05
IMBALANCE_MIN_STACK=3
# Monitor de escenarios
ANALYSIS_LOOKBACK_MS=300000
ANALYSIS_RECENT_BARS=3
# Polymarket (BTC Up/Down 5m)
PM_HISTORY=24
# Credenciales de Polymarket para el canal TWAP: ponerlas en .env.local (gitignored), NUNCA aqui
# PM_CLOB_API_KEY=
# PM_CLOB_SECRET=
# PM_CLOB_PASSPHRASE=
# PM_CHAINLINK_API_KEY=
# Motor de senales (PM_*)
# Parametros del motor y base de datos: ver docs/features/signal-engine.md
PM_DB_PATH=data/polymarket.db
# Backups de la base a S3/R2 (docs/guides/deployment.md). Vacio = desactivado. Secretos solo en .env.local / variables de Railway
# BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_PREFIX=updown/
# BACKUP_INTERVAL_H=24
# PM_DB_RESTORE=false
PM_FEE_RATE=0.05
PM_MIN_EDGE=0.04
PM_BANKROLL=1000
PM_MODEL_WEIGHT=0.6
PM_FLOW_GAIN=0.3
# Motor B sincronizado (solo en memoria, ver docs/features/engine-sync.md)
PM_SYNC_ENABLED=true
PM_SYNC_DELAY_MS=300


