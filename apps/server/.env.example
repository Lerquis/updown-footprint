PORT=4000
# Origen permitido para el frontend (Origin check de WS). Vacio = permitir todos (solo dev)
ALLOWED_ORIGIN=http://localhost:3000
SYMBOL=btcusdt
# Spot: wss://stream.binance.com:9443/ws  |  Futuros USDT-M: wss://fstream.binance.com/ws
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
RETENTION_MS=900000
TRADES_MAX=100000
BACKFILL=true
BINANCE_REST_URL=https://api.binance.com/api/v3
# Heatmap de liquidez (/ws/depth)
DEPTH_STEP=1
DEPTH_RANGE_PCT=0.001
DEPTH_INTERVAL_MS=1000
DEPTH_SNAPSHOT_LIMIT=5000
# Orderflow (footprint, CVD, senales)
BAR_MS=60000
BAR_HISTORY=60
FOOTPRINT_TICK=1
IMBALANCE_RATIO=3
IMBALANCE_MIN_VOL=0.05
IMBALANCE_MIN_STACK=3
# Monitor de escenarios
ANALYSIS_LOOKBACK_MS=300000
ANALYSIS_RECENT_BARS=3
# Polymarket (BTC Up/Down 5m)
PM_HISTORY=24
# Credenciales de Polymarket para el canal TWAP: ponerlas en .env.local (gitignored), NUNCA aqui
# PM_CLOB_API_KEY=
# PM_CLOB_SECRET=
# PM_CLOB_PASSPHRASE=
# PM_CHAINLINK_API_KEY=
# EOA que creo la API key (POLY_ADDRESS de las peticiones autenticadas). Tambien en .env.local
# PM_SIGNER_ADDRESS=
# Proxy wallet de la cuenta (maker de la orden de prueba de latencia). Tambien en .env.local
# PM_FUNDER_ADDRESS=
# Latencia hacia el CLOB (/ws/latency, solo lectura): ver docs/features/latency.md
PM_CLOB_URL=https://clob.polymarket.com
PM_LATENCY_INTERVAL_MS=15000
PM_LATENCY_KEEPALIVE_MS=5000
PM_LATENCY_HISTORY=40
# Compras reales del motor C (docs/features/live-trading.md). Clave y contrasena SOLO en .env.local / Railway
# PM_WALLET_PRIVATE_KEY=
# TRADING_PASSWORD=
PM_LIVE_SCALE=0.2
PM_LIVE_MIN_USD=1
PM_LIVE_MAX_USD=10
PM_LIVE_MAX_MARKET_USD=40
# 1 = sin limite de precio (compra hasta 0.99, vende desde 0.01); 0.02 = senal +-2c
PM_LIVE_SLIPPAGE=1
# Canal de usuario de Polymarket: hora exacta de cada ejecucion
PM_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
# Motor de senales (PM_*)
# Parametros del motor y base de datos: ver docs/features/signal-engine.md
# Se usa con la generacion: data/polymarket-v2.db (ADR 0011)
PM_DB_PATH=data/polymarket.db
# Backups de la base a S3/R2 (docs/guides/deployment.md). Vacio = desactivado. Secretos solo en .env.local / variables de Railway
# BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_PREFIX=updown/
# BACKUP_INTERVAL_H=1
# BACKUP_KEEP_H=48
# BACKUP_SHUTDOWN_TIMEOUT_S=150
# PM_DB_RESTORE=false
PM_FEE_RATE=0.05
PM_MIN_EDGE=0.04
PM_BANKROLL=1000
PM_MODEL_WEIGHT=0.6
PM_FLOW_GAIN=0.3
# Replays del motor A con retraso (npm run replays): copias descargadas de R2 e informe
REPLAY_DIR=data/replays
# Motores A y C: retraso (ms) tras cada segundo de Binance (ver docs/features/engines.md)
PM_ENGINE_A_DELAY_MS=0
PM_ENGINE_C_DELAY_MS=150
# Motores D (predictivo, taker) y E (libro, maker): ver docs/features/predictive-engines.md
PM_FAST_TICK_MS=100
PM_FAST_MODEL_WEIGHT=0.6
PM_FAST_MODEL_WEIGHT_END=0.3
PM_DRIFT_GAIN=3
# PM_CALIBRATION_PATH=data/calibration.json
PM_D_MIN_EDGE=0.1
PM_D_LIMIT_MARGIN=0.03
PM_D_EXIT_MARGIN=0.03
PM_D_NO_ENTRY_S=20
PM_E_EDGE=0.05
PM_E_EXIT_EDGE=0.04
PM_E_NEED_DRIFT=0.05
PM_E_DROP_CANCEL=0.01
PM_E_STOP=0.15
PM_E_MIN_REST_MS=500
PM_E_NO_ENTRY_S=20
# Papel realista de D y E: retraso de una orden taker, de la entrada al libro de una maker y de una cancelacion
PM_PAPER_TAKER_LATENCY_MS=1500
PM_PAPER_POST_LATENCY_MS=150
PM_PAPER_CANCEL_LATENCY_MS=100


